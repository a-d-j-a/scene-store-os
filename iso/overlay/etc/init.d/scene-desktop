#!/bin/sh
# scene-desktop — start the scene compositor + shell
# Runs as PID 1 continuation from rcS

export HOME=/home/user
export USER=user
export PATH=/usr/bin:/bin:/sbin:/usr/sbin
export TERM=xterm-256color

# try to switch to a display tty
chvt 7 2>/dev/null || chvt 1 2>/dev/null || true

# wait for dri nodes
for i in $(seq 1 10); do
    [ -e /dev/dri/card0 ] && break
    sleep 0.5
done

# HDA codec probe: snd_hda_intel probes the codec once at boot and can
# fail under QEMU TCG (the emulated codec reset races the TCG clock).
# Rebind the PCI function to re-run the probe; keep retrying until the
# PCM device exists or we give up after 18s.
HC=0
for i in 1 2 3 4 5 6; do
    [ -e /dev/snd/pcmC0D0p ] && HC=1 && break
    for d in /sys/bus/pci/drivers/snd_hda_intel/*/; do
        b=$(basename "$d")
        case "$b" in module|bind|unbind|uevent|new_id|remove_id) continue ;; esac
        echo "$b" > /sys/bus/pci/drivers/snd_hda_intel/unbind 2>/dev/null
        echo "$b" > /sys/bus/pci/drivers/snd_hda_intel/bind 2>/dev/null
    done
    sleep 3
done
# DRM/KMS compositor (own code, kernel UAPI — the boot path)
# /dev/console maps to ttyS0 (last console= param), so iso-drm's
# stdout/stderr land on the serial log automatically.
# autolaunch=NAME / videoclip=PATH kernel cmdline tokens are forwarded
# so apps and the importer clip can be set at login (headless test
# path: no input needed).
if [ -x /usr/bin/iso-drm ]; then
    echo "Starting iso-drm compositor..."
    AUTOLAUNCH=""
    for tok in $(cat /proc/cmdline); do
        case "$tok" in
            autolaunch=*) AUTOLAUNCH="$AUTOLAUNCH --autolaunch=${tok#autolaunch=}" ;;
            videoclip=*)  AUTOLAUNCH="$AUTOLAUNCH --videoclip=${tok#videoclip=}" ;;
            iso-debug) AUTOLAUNCH="$AUTOLAUNCH --debug" ;;
        esac
    done
    exec /usr/bin/iso-drm $AUTOLAUNCH
fi

# wlroots compositor (alternative backend, if built)
if [ -x /usr/bin/iso-compositor ]; then
    echo "Starting wlroots compositor..."
    exec su -c '/usr/bin/iso-compositor' user 2>/dev/null || \
        exec /usr/bin/iso-compositor
fi

echo "No compositor found. Dropping to shell."
exec /bin/sh
