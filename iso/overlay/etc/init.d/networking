#!/bin/sh
# networking - bring up wired NICs with DHCP, then try WiFi via wpa_supplicant.
# Runs from rcS before the desktop starts; logs to the serial console.

export PATH=/usr/bin:/bin:/sbin:/usr/sbin

# ---- wired first ----
for iface in $(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | grep -v '^wlan'); do
    ifconfig "$iface" up 2>/dev/null || true
    udhcpc -i "$iface" -b -q >/dev/null 2>&1 || true
    IP=$(ip addr show "$iface" 2>/dev/null | grep 'inet ' | awk '{print $2}')
    echo "network: $iface up ${IP:-no lease}"
done

# ---- WiFi via wpa_supplicant (if available and wlan interfaces exist) ----
if command -v wpa_supplicant >/dev/null 2>&1; then
    for wlan in $(ls /sys/class/net 2>/dev/null | grep '^wlan'); do
        echo "network: WiFi scan on $wlan"
        # Try any saved config first, fall back to open scan
        if [ -f /etc/wpa_supplicant.conf ]; then
            wpa_supplicant -i "$wlan" -c /etc/wpa_supplicant.conf -B \
                -P /run/wpa_${wlan}.pid 2>/dev/null || true
        else
            # No config: try open network discovery
            wpa_supplicant -i "$wlan" -D nl80211,wext -c <(echo 'ctrl_interface=/var/run/wpa_supplicant
update_config=1
ap_scan=1') -B -P /run/wpa_${wlan}.pid 2>/dev/null || true
        fi
        # Give wpa_supplicant a moment to associate
        sleep 2
        udhcpc -i "$wlan" -b -q >/dev/null 2>&1 || true
        IP=$(ip addr show "$wlan" 2>/dev/null | grep 'inet ' | awk '{print $2}')
        echo "network: $wlan ${IP:-no lease}"
    done
fi

for tok in $(cat /proc/cmdline 2>/dev/null); do
    case "$tok" in
        pkgtest=check:*)
            PKG="${tok#pkgtest=check:}"
            echo "network: pkgtest: check:$PKG"
            if command -v "$PKG" >/dev/null 2>&1; then
                echo "network: pkgtest: $PKG present OK"
            else
                echo "network: pkgtest: $PKG absent FAIL"
            fi
            ;;
        pkgtest=*)
            PKG="${tok#pkgtest=}"
            echo "network: pkgtest: apk add --no-cache $PKG"
            if apk add --no-cache "$PKG" >/dev/null 2>&1; then
                echo "network: pkgtest: $PKG installed OK"
            else
                echo "network: pkgtest: $PKG FAILED"
            fi
            ;;
    esac
done

exit 0
